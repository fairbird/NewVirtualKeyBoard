msgid ""
"\n"
"Press OK or Exit to abort!"
msgstr ""
"\n"
"Πατήστε OK ή EXIT για ακύρωση!"

msgid "0-9 - Text input like on a phone, when the input field is selected"
msgstr "0-9 - Εισαγωγή κειμένου όπως σε τηλέφωνο, όταν είναι επιλεγμένο το πεδίο εισαγωγής"

msgid "Alt"
msgstr "Alt"

msgid "Background color"
msgstr "Χρώμα φόντου"

msgid "Black"
msgstr "Μαύρο"

msgid "Blue - Shift"
msgstr "Μπλε - Shift"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Cancel execution?"
msgstr "Να γίνει ακύρωση της εκτέλεσης;"

msgid "Caps"
msgstr "Caps"

msgid "Clear"
msgstr "Clear"

msgid "Clear search history"
msgstr "Εκκαθάριση ιστορικού αναζήτησης"

msgid "Console"
msgstr "Κονσόλα"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Default"
msgstr "Προεπιλογή"

msgid "Delete the search history?"
msgstr "Να γίνει διαγραφή του ιστορικού αναζήτησης;"

msgid "Do you want to install it now?"
msgstr "Θέλετε να την εγκαταστήσετε τώρα;"

msgid "Enable/Disable Checking Online Update"
msgstr "Ενεργοποίηση/απενεργοποίηση ελέγχου online ενημέρωσης"

msgid "Enter"
msgstr "Enter"

#. TRANSLATORS: key caps of the on-screen keyboard - keep them as
#. short as the English ones, the keys are small
msgid "Esc"
msgstr "Esc"

msgid "Execution finished!!"
msgstr "Η εκτέλεση ολοκληρώθηκε!!"

msgid "Execution progress:"
msgstr "Πρόοδος εκτέλεσης:"

msgid "Exit"
msgstr "Exit"

msgid "Exit - Close without taking the text"
msgstr "Exit - Κλείσιμο χωρίς λήψη του κειμένου"

msgid "Failed to download language, try later"
msgstr "Αποτυχία λήψης της γλώσσας, δοκιμάστε αργότερα"

msgid "Fast forward - Insert space"
msgstr "Γρήγορη προώθηση - Εισαγωγή κενού διαστήματος"

msgid "Font size (-10 to +30)"
msgstr "Μέγεθος γραμματοσειράς (-10 έως +30)"

msgid "Green - Enter: confirm the text and close"
msgstr "Πράσινο - Enter: επιβεβαίωση του κειμένου και κλείσιμο"

msgid "Help"
msgstr "Help"

msgid "Hide"
msgstr "Απόκρυψη"

msgid "Image virtual keyboard"
msgstr "Εικονικό πληκτρολόγιο του image"

msgid "Info - Show this screen again"
msgstr "Info - Εμφάνιση αυτής της οθόνης ξανά"

msgid "Install language"
msgstr "Εγκατάσταση γλώσσας"

msgid "Installing last update, enigma will be started after install"
msgstr "Γίνεται εγκατάσταση της τελευταίας ενημέρωσης, το enigma θα ξεκινήσει μετά την εγκατάσταση"

msgid "Keyboard layout selection"
msgstr "Επιλογή διάταξης πληκτρολογίου"

msgid "Language downloaded successfully, exit from install"
msgstr "Η γλώσσα ελήφθη με επιτυχία, έξοδος από την εγκατάσταση"

msgid "Language removed from installed package"
msgstr "Η γλώσσα αφαιρέθηκε από το εγκατεστημένο πακέτο"

msgid "Left"
msgstr "Αριστερά"

msgid "Left / Right at the edge of the keyboard - Switch to the suggestions or the search history"
msgstr "Αριστερά / Δεξιά στην άκρη του πληκτρολογίου - Εναλλαγή στις προτάσεις ή στο ιστορικό αναζήτησης"

#, python-format
msgid "Loading the keyboard layout %s failed"
msgstr "Αποτυχία φόρτωσης της διάταξης πληκτρολογίου %s"

msgid "Menu - Settings, install languages, clear the search history"
msgstr "Menu - Ρυθμίσεις, εγκατάσταση γλωσσών, εκκαθάριση ιστορικού αναζήτησης"

msgid "Mostly transparent"
msgstr "Σχεδόν διαφανές"

msgid "New Virtual Keyboard"
msgstr "Νέο εικονικό πληκτρολόγιο"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "New Virtual KeyBoard - Αρχικός κώδικας SamSamSam (e2iplayer). Συνεργάτες: mfaraj57 και Fairbird. Θέμα και τροποποιήσεις: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Ρυθμίσεις New Virtual KeyBoard"

msgid "New version"
msgstr "Νέα έκδοση"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Ρύθμιση NewVirtualKeyBoard"

msgid "Numeric keypad"
msgstr "Αριθμητικό πληκτρολόγιο"

msgid "Numeric keypad for numbers"
msgstr "Αριθμητικό πληκτρολόγιο για αριθμούς"

msgid "OK - Type the selected key / take the selected suggestion or history entry"
msgstr "OK - Πληκτρολόγηση του επιλεγμένου πλήκτρου / επιλογή της επιλεγμένης πρότασης ή καταχώρισης ιστορικού"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / ΠΡΑΣΙΝΟ - Αποδοχή, EXIT - Ακύρωση"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - Εναλλαγή μεταξύ πληκτρολογίου, προτάσεων και ιστορικού αναζήτησης"

msgid "Page Down - Clear input text"
msgstr "Σελίδα κάτω - Εκκαθάριση κειμένου εισαγωγής"

msgid "Page Up - Insert space"
msgstr "Σελίδα πάνω - Εισαγωγή διαστήματος"

msgid "Press ok to install language"
msgstr "Πατήστε OK για να εγκαταστήσετε τη γλώσσα"

msgid "Press ok to remove language"
msgstr "Πατήστε OK για να αφαιρέσετε τη γλώσσα"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Προηγούμενο / Επόμενο - Εναλλαγή μεταξύ πληκτρολογίου, προτάσεων και ιστορικού αναζήτησης"

msgid "Red - Backspace"
msgstr "Κόκκινο - Backspace"

msgid "Remember last search entry"
msgstr "Απομνημόνευση τελευταίας καταχώρισης αναζήτησης"

msgid "Restart GUI"
msgstr "Επανεκκίνηση του GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "Να γίνει επανεκκίνηση του enigma2 για να φορτωθούν οι νέες ρυθμίσεις;"

msgid "Rewind - Clear input text"
msgstr "Επαναφορά - Εκκαθάριση κειμένου εισαγωγής"

msgid "Right"
msgstr "Δεξιά"

msgid "Save"
msgstr "Αποθήκευση"

msgid "Search history"
msgstr "Ιστορικό αναζητήσεων"

msgid "Search history entries (1-99999)"
msgstr "Καταχωρίσεις ιστορικού αναζήτησης (1-99999)"

msgid "Semi-transparent"
msgstr "Ημιδιαφανές"

msgid "Setup virtual keyboard"
msgstr "Ρύθμιση εικονικού πληκτρολογίου"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "Εμφάνιση σημαιών"

msgid "Show plugin in Plugin Browser"
msgstr "Εμφάνιση NewVirtualKeyBoard στη Περιήγηση πρόσθετων"

msgid "Show search history"
msgstr "Εμφάνιση ιστορικού αναζήτησης"

msgid "Show suggestions"
msgstr "Εμφάνιση προτάσεων"

msgid "Suggestions"
msgstr "Προτάσεις"

msgid "Suggestions provider"
msgstr "Πάροχος προτάσεων"

msgid "Switching the keyboard failed"
msgstr "Αποτυχία εναλλαγής του πληκτρολογίου"

msgid "Text - Switch language"
msgstr "Text - Εναλλαγή γλώσσας"

msgid "Text field alignment"
msgstr "Στοίχιση πεδίου κειμένου"

msgid "Text input method-keyboard"
msgstr "Μέθοδος εισαγωγής κειμένου-πληκτρολόγιο"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Λείπει το αντίγραφο ασφαλείας του πληκτρολογίου του image, το New Virtual Keyboard παραμένει ενεργό."

msgid "Transparent"
msgstr "Διαφανές"

msgid "Virtual Keyboard"
msgstr "Εικονικό πληκτρολόγιο"

msgid "Yellow - AltGr"
msgstr "Κίτρινο - AltGr"

msgid "is available"
msgstr "είναι διαθέσιμη"
